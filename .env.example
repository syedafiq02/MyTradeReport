# Copy this file to .env and adjust. Never put your MT5 trading password here -
# log in to your account inside the MetaTrader 5 terminal instead.

# --- Server (keep 127.0.0.1 so the dashboard is only reachable from this PC) ---
HOST=127.0.0.1
PORT=5000

# --- MetaTrader 5 ---
# Full path to terminal64.exe. Recommended when several MT5 terminals are installed,
# otherwise Python attaches to whichever terminal it finds first.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# Trade-server time offset from UTC in hours (e.g. 2 or 3), or "auto" to detect it
# from live ticks while the market is open.
MT5_SERVER_UTC_OFFSET=auto

# First year to read deal history from on a full sync.
HISTORY_START_YEAR=2010

# --- Synchronisation (seconds) ---
POLL_INTERVAL=5
HISTORY_INTERVAL=60
SNAPSHOT_INTERVAL=30
# Data older than this is shown as STALE (default: max(30, 4 x POLL_INTERVAL)).
STALE_AFTER=30

# --- Optional access gate (dashboard password, NOT your MT5 password) ---
# Preferred: generate a hash with  .venv\Scripts\python app.py hash-password
DASHBOARD_PASSWORD_HASH=
# Or a plain password (simpler, less safe if someone can read this file):
DASHBOARD_PASSWORD=

# Optional. If empty, a random key is generated and stored in data\.secret_key
SECRET_KEY=

# Synthetic, clearly-labelled DEMO data (uses a separate database file).
DEMO_MODE=0
